{
  "name": "pied-piper",
  "private": true,
  "version": "0.0.0",
  "description": "A private desktop knowledge and productivity workspace.",
  "author": "Riddhim Rathor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:renderer": "vite",
    "dev:electron": "set ELECTRON_RUN_AS_NODE=&& wait-on tcp:127.0.0.1:5180 && electron .",
    "dev:desktop": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:desktop": "npm run build && electron-builder --win nsis",
    "rebuild:sqlite": "set npm_config_runtime=electron&& set npm_config_target=37.10.3&& set npm_config_disturl=https://electronjs.org/headers&& npm rebuild better-sqlite3",
    "verify:data": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/verify-local-db.cjs",
    "test:encyclopedia": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-encyclopedia.cjs",
    "test:todo": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-todo.cjs",
    "test:notes": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-notes.cjs",
    "test:recycle-bin": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-recycle-bin.cjs",
    "test:settings": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-settings.cjs",
    "test:database-files": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/test-database-files.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-character-count": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-ordered-list": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.2.0",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "build": {
    "appId": "com.piedpiper.desktop",
    "productName": "Pied Piper",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
